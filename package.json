{
  "name": "khula",
  "private": true,
  "version": "0.1.0",
  "description": "Khula — secure multi-industry service marketplace for South Africa",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": "^22.13.0 || ^24.3.0"
  },
  "scripts": {
    "dev:web": "npm run dev --workspace @khula/web",
    "dev:mobile": "npm run start --workspace @khula/mobile",
    "build:web": "npm run build --workspace @khula/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:test:fast": "node supabase/tests/rls-scenarios.pglite.mjs",
    "db:types": "supabase gen types typescript --local > packages/shared/src/types/database.generated.ts",
    "functions:serve": "supabase functions serve --env-file supabase/functions/.env"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "typescript": "5.9.3"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.33"
    }
  }
}
