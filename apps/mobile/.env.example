# EXPO_PUBLIC_* values are bundled into the app binary — never put secrets here.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Next.js BFF (bookings, privacy). Use your LAN IP for a physical device in dev.
EXPO_PUBLIC_API_URL=http://localhost:3000
