# Copy to supabase/functions/.env for `supabase functions serve` (git-ignored).
# In production set these with: supabase secrets set --env-file ./supabase/functions/.env
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected automatically.

PAYSTACK_SECRET_KEY=replace-with-your-paystack-secret-key
PAYSTACK_CALLBACK_URL=khula://payments/complete
PAYSTACK_ENFORCE_IP_ALLOWLIST=false
PAYSTACK_AUTO_REFUND=true

PAYFAST_MERCHANT_ID=10000100
PAYFAST_PASSPHRASE=change-me-to-a-long-random-passphrase
PAYFAST_SANDBOX=true

ALLOWED_ORIGINS=http://localhost:3000,https://app.khula.co.za
