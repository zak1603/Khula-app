{
  "name": "@khula/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Shared types, Zod validation, and pure helpers for Khula web + mobile",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types/index.ts",
    "./database": "./src/types/database.ts",
    "./validation": "./src/validation/index.ts",
    "./tailwind-preset": "./tailwind-preset.cjs",
    "./palette": "./palette.cjs"
  },
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
